generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js ----------

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  phone            String?
  role             String    @default("CLIENT") // CLIENT | TRAINER
  createdAt        DateTime  @default(now())
  // Profile (editable at /account)
  emergencyContact String?
  notes            String? // parking, access, health notes for the trainer
  notifyEmail      Boolean   @default(true) // booking status emails (stored only — no mail service yet)
  notifyReminders  Boolean   @default(true) // 24h session reminders

  accounts  Account[]
  sessions  Session[]
  locations Location[]
  bookings  Booking[]
  series    BookingSeries[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Trainer configuration ----------

model TrainerSettings {
  id              String  @id @default("singleton")
  timezone        String  @default("Europe/London")
  homeAddress     String?
  homePlaceId     String?
  homeLat         Float?
  homeLng         Float?
  maxRadiusMiles  Float   @default(15)
  bufferMinutes   Int     @default(10)
  slotStepMinutes Int     @default(30)
  minNoticeHours  Int     @default(24)
}

/// Towns/areas the trainer covers, each with its own radius. When none exist, TrainerSettings.maxRadiusMiles
/// around the home base applies instead.
model ServiceArea {
  id          String   @id @default(cuid())
  label       String
  formatted   String
  placeId     String?
  lat         Float
  lng         Float
  radiusMiles Float    @default(5)
  createdAt   DateTime @default(now())

  locations Location[]
}

/// The hero chips on the marketing site (Health, Movement, Prehab…). Each opens a
/// modal explaining what Toby means by it. Trainer-editable at /trainer/content.
model Pillar {
  id        String   @id @default(cuid())
  label     String
  body      String
  /// Manual ordering in the hero; lower first.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A clip from Toby's Instagram, shown in the "From Instagram" grid on the marketing
/// site. Curated rather than synced: Instagram has no public feed API, so Toby adds the
/// ones worth showing. videoUrl is an MP4 served by us (inline playback, our own styling);
/// permalink points back at the original post.
model SocialPost {
  id        String   @id @default(cuid())
  caption   String
  /// Still shown before playback; also the video's poster frame.
  posterUrl String
  /// MP4/WebM played inline. Null renders the tile as a still that links out.
  videoUrl  String?
  /// The original instagram.com post, for "View on Instagram".
  permalink String
  /// Manual ordering in the grid; lower first.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Repeating exception: e.g. every 2nd Wednesday 12:00–14:00 unavailable, from startDate until endDate.
/// Expanded into virtual AvailabilityException entries at read time (see getAvailability).
model RecurringException {
  id            String   @id @default(cuid())
  weekday       Int // 0 = Sunday ... 6 = Saturday
  intervalWeeks Int      @default(1)
  startDate     String // yyyy-MM-dd — first occurrence (defines the cycle)
  endDate       String? // yyyy-MM-dd inclusive; null = indefinitely
  type          String // UNAVAILABLE | EXTRA
  startTime     String?
  endTime       String?
  note          String?
  createdAt     DateTime @default(now())
}

/// Weekly template. Multiple ranges per weekday allowed. Times are "HH:mm" in trainer tz.
model AvailabilityRule {
  id        String @id @default(cuid())
  weekday   Int // 0 = Sunday ... 6 = Saturday
  startTime String
  endTime   String

  @@index([weekday])
}

/// Per-date overrides. UNAVAILABLE with null times = whole day off.
model AvailabilityException {
  id        String  @id @default(cuid())
  date      String // "yyyy-MM-dd" in trainer tz
  type      String // UNAVAILABLE | EXTRA
  startTime String?
  endTime   String?
  note      String?

  @@index([date])
}

// ---------- Locations ----------

model Location {
  id            String       @id @default(cuid())
  userId        String
  label         String?
  formatted     String
  placeId       String?
  lat           Float
  lng           Float
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Which service area accepted this address (null = fallback home radius or pre-areas data).
  serviceAreaId String?
  serviceArea   ServiceArea? @relation(fields: [serviceAreaId], references: [id], onDelete: SetNull)

  bookings Booking[]
  series   BookingSeries[]
}

// ---------- Bookings ----------

model BookingSeries {
  id          String   @id @default(cuid())
  clientId    String
  locationId  String
  /// IN_PERSON | ONLINE — see Booking.sessionType.
  sessionType String   @default("IN_PERSON")
  weekday     Int
  startTime   String // "HH:mm" trainer tz
  durationMin Int
  startDate   String // yyyy-MM-dd
  endDate     String // yyyy-MM-dd
  status      String   @default("PENDING") // PENDING | ACCEPTED | DECLINED | CANCELLED
  createdAt   DateTime @default(now())

  client   User      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  location Location  @relation(fields: [locationId], references: [id])
  bookings Booking[]
}

model Booking {
  id           String    @id @default(cuid())
  clientId     String
  seriesId     String?
  locationId   String
  /// IN_PERSON | ONLINE. Online sessions are run from the trainer's home, so
  /// they are scheduled against the home coordinates and the commute engine
  /// reserves the drive back automatically.
  sessionType  String    @default("IN_PERSON")
  startAt      DateTime
  endAt        DateTime
  durationMin  Int
  status       String    @default("PENDING") // PENDING | ACCEPTED | DECLINED | CANCELLED_BY_CLIENT | CANCELLED_BY_TRAINER | COMPLETED
  clientNote   String?
  trainerNote  String?
  cancelReason String?
  cancelledAt  DateTime?
  createdAt    DateTime  @default(now())

  client    User           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  series    BookingSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  location  Location       @relation(fields: [locationId], references: [id])
  videoRoom VideoRoom?

  @@index([startAt, status])
  @@index([clientId])
}

/// A Daily.co room backing one ONLINE session. Created when the trainer accepts
/// (or lazily on first join) and deleted when the session is cancelled or moved —
/// the room's nbf/exp window is bound to the booking's times, so a reschedule
/// invalidates it.
model VideoRoom {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  /// Daily room name (the last path segment of roomUrl).
  roomName   String   @unique
  roomUrl    String
  /// When Daily auto-deletes the room; mirrors the room's `exp`.
  expiresAt  DateTime
  /// Unguessable secret for the shareable guest link, when the trainer has issued
  /// one. A bearer credential: anyone holding it can join as a guest during the
  /// session window, so it is generated on request rather than by default and can
  /// be revoked by clearing it.
  guestToken String?  @unique
  createdAt  DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

/// Cached Distance Matrix results keyed by rounded coordinates.
model CommuteCache {
  id        String   @id @default(cuid())
  fromKey   String
  toKey     String
  seconds   Int
  meters    Int
  estimated Boolean  @default(false) // true when computed via haversine fallback
  fetchedAt DateTime @default(now())

  @@unique([fromKey, toKey])
}
